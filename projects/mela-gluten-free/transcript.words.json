  "segments": [
    {
      "start": 1.07,
      "end": 5.57,
      "text": "E se il peccato originale dell'umanità fosse proprio ciò di cui l'innovazione ha bisogno?"
    },
    {
      "start": 6.55,
      "end": 9.99,
      "text": "Nel gluten-free, una mela può cambiare il comportamento di un intero impasto."
    },
    {
      "start": 10.19,
      "end": 15.43,
      "text": "Alcune fibre di mela possono legare almeno 20 volte il proprio peso in acqua."
    },
    {
      "start": 15.51,
      "end": 19.63,
      "text": "Una proprietà enorme che può migliorare struttura, lavorabilità,"
    },
    {
      "start": 19.83,
      "end": 24.75,
      "text": "oppure compromettere completamente il risultato se la ricetta non viene riequilibrata."
    },
    {
      "start": 24.95,
      "end": 28.99,
      "text": "È qui che comincia il vero lavoro di chi lavora in ricerca e sviluppo dell'industria alimentare."
    },
    {
      "start": 28.99,
      "end": 31.89,
      "text": "Ad esempio, in uno studio sul pane senza glutine,"
    },
    {
      "start": 32.09,
      "end": 38.19,
      "text": "una formulazione con 7 grammi di fibra di mela e 4 grammi di HPMC ogni 100 grammi di miscela"
    },
    {
      "start": 38.19,
      "end": 43.23,
      "text": "ha raggiunto un volume specifico di 3,97 cm3 per grammo"
    },
    {
      "start": 43.23,
      "end": 46.39,
      "text": "e una durezza della mollica di appena 2,10 N."
    },
    {
      "start": 46.69,
      "end": 48.35,
      "text": "Tradotto. Che cosa vuol dire?"
    },
    {
      "start": 48.69,
      "end": 51.43,
      "text": "Più fibra, ma con una mollica sviluppata e morbida."
    },
    {
      "start": 51.63,
      "end": 54.75,
      "text": "L'innovazione quindi non consiste nell'aggiungere un ingrediente."
    },
    {
      "start": 54.99,
      "end": 57.75,
      "text": "Consiste nel far funzionare l'intera formulazione."
    },
    {
      "start": 57.75,
      "end": 62.85,
      "text": "Scopri questi nuovi approcci alla formulazione al festival dell'innovazione ancora alimentare."
    },
    {
      "start": 62.99,
      "end": 67.11,
      "text": "Il festival sarà online e gratuito dal 9 al 12 novembre 2026."
    }
  ]
}